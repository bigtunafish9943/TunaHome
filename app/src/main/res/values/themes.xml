<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Every screen. Starts as Deep Sea; TunaTheme lays the chosen theme over it. -->
    <style name="TunaHome" parent="@android:style/Theme.Material.NoActionBar">
        <item name="tsNavy">#041431</item>
        <item name="tsDeep">#0A2350</item>
        <item name="tsSurface">#081A3A</item>
        <item name="tsSurfaceBorder">#142F58</item>
        <item name="tsAccent">#0CC8F6</item>
        <item name="tsAccentSoft">#8BE6FC</item>
        <item name="tsBlue">#0B74D1</item>
        <item name="tsText">#EEF5FB</item>
        <item name="tsTextSecondary">#9FB3CC</item>
        <item name="android:windowBackground">@drawable/home_bg</item>
        <item name="android:colorAccent">?attr/tsAccent</item>
        <item name="android:alertDialogTheme">@style/TunaDialog</item>
    </style>

    <style name="TunaDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">?attr/tsAccent</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
    </style>

    <!-- Text that may sit on a picture -->
    <style name="Shadowed">
        <item name="android:shadowColor">#B3000000</item>
        <item name="android:shadowRadius">5</item>
        <item name="android:shadowDy">1</item>
    </style>

    <style name="RowTitle" parent="Shadowed">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/tsText</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginStart">@dimen/safe_side</item>
        <item name="android:layout_marginTop">14dp</item>
    </style>

    <!-- A row of apps that runs to both edges of the screen; its first tile lines up with the titles -->
    <style name="AppRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">40dp</item>
        <item name="android:paddingEnd">40dp</item>
        <item name="android:clipChildren">false</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:descendantFocusability">afterDescendants</item>
    </style>

    <style name="IconButton">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/icon_button_bg</item>
        <item name="android:tint">@color/button_text</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
</resources>
