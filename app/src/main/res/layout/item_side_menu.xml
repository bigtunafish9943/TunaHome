<?xml version="1.0" encoding="utf-8"?>
<!-- One entry in the side menu: an icon, and its name while the menu is open -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/side_menu_item_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="20dp">

    <ImageView
        android:id="@+id/menuIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:tint="?attr/tsText" />

    <TextView
        android:id="@+id/menuLabel"
        style="@style/Shadowed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:maxLines="1"
        android:textColor="?attr/tsText"
        android:textSize="17sp"
        android:visibility="gone" />
</LinearLayout>
