<?xml version="1.0" encoding="utf-8"?>
<!-- One app. Its size, card, outline and name are set in code from the viewer's settings. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tile"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:longClickable="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/card"
        android:layout_width="@dimen/tile_width"
        android:layout_height="@dimen/tile_height">

        <ImageView
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <!-- The name inside the card, for the "icon and name" style -->
        <TextView
            android:id="@+id/cardLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp"
            android:textColor="?attr/tsText"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Shown on apps that need the PIN -->
        <ImageView
            android:id="@+id/lockBadge"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:contentDescription="@string/lock_badge"
            android:src="@drawable/ic_lock"
            android:visibility="gone" />

        <!-- How far through a Watch Next show you are -->
        <View
            android:id="@+id/progress"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_gravity="bottom|start"
            android:background="?attr/tsAccent"
            android:visibility="gone" />

        <View
            android:id="@+id/ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible" />
    </FrameLayout>

    <TextView
        android:id="@+id/label"
        style="@style/Shadowed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/tsText"
        android:textSize="13sp"
        android:visibility="invisible" />
</LinearLayout>
