<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The background: a picture, a video, or nothing (the theme's colours) -->
    <ImageView
        android:id="@+id/backdropImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <androidx.media3.ui.PlayerView
        android:id="@+id/backdropVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:descendantFocusability="blocksDescendants"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:resize_mode="zoom"
        app:shutter_background_color="@android:color/transparent"
        app:surface_type="texture_view"
        app:use_controller="false" />

    <!-- The picture of the app you're on, when the background follows it -->
    <ImageView
        android:id="@+id/followBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- A Watch Next preview, playing silently while you rest on that show -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/previewVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:descendantFocusability="blocksDescendants"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:resize_mode="zoom"
        app:shutter_background_color="@android:color/transparent"
        app:surface_type="texture_view"
        app:use_controller="false" />

    <!-- Darkens the background so names and the clock stay readable -->
    <View
        android:id="@+id/backdropShade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.3"
        android:background="#FF000000"
        android:visibility="gone" />

    <!-- Snow, rain, leaves and other moving effects, when switched on -->
    <com.tunastream.home.EffectsView
        android:id="@+id/effects"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- What the background shows, when a wallpaper app names it -->
    <TextView
        android:id="@+id/backdropCaption"
        style="@style/Shadowed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/safe_side"
        android:layout_marginBottom="@dimen/safe_top"
        android:textColor="?attr/tsText"
        android:textSize="13sp"
        android:visibility="gone" />

    <com.tunastream.home.HomeScroll
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:fadingEdgeLength="56dp"
        android:fillViewport="true"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingTop="@dimen/safe_top"
            android:paddingBottom="@dimen/safe_top">

            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/safe_side"
                android:layout_marginEnd="@dimen/safe_side"
                android:gravity="center_vertical"
                android:minHeight="46dp"
                android:orientation="horizontal">

                <include layout="@layout/brand" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Free storage and memory, when switched on -->
                <TextView
                    android:id="@+id/systemInfo"
                    style="@style/Shadowed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:alpha="0.85"
                    android:focusable="false"
                    android:maxLines="1"
                    android:textColor="?attr/tsTextSecondary"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <!-- Shown only while a VPN is on -->
                <ImageView
                    android:id="@+id/vpnIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="10dp"
                    android:alpha="0.85"
                    android:contentDescription="@string/vpn_on"
                    android:focusable="false"
                    android:src="@drawable/ic_vpn"
                    android:tint="?attr/tsText"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/networkIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="14dp"
                    android:alpha="0.85"
                    android:contentDescription="@null"
                    android:focusable="false"
                    android:tint="?attr/tsText"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/openSearch"
                    style="@style/IconButton"
                    android:contentDescription="@string/search"
                    android:src="@drawable/ic_search" />

                <ImageView
                    android:id="@+id/checkUpdate"
                    style="@style/IconButton"
                    android:contentDescription="@string/set_update"
                    android:src="@drawable/ic_update" />

                <ImageView
                    android:id="@+id/openTvSettings"
                    style="@style/IconButton"
                    android:contentDescription="@string/tv_settings"
                    android:src="@drawable/ic_tv" />

                <ImageView
                    android:id="@+id/openSettings"
                    style="@style/IconButton"
                    android:contentDescription="@string/tunahome_settings"
                    android:src="@drawable/ic_settings" />

                <!-- The weather: its picture, the temperature, and a line of detail -->
                <LinearLayout
                    android:id="@+id/weatherBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/weatherIcon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/weatherTemp"
                            style="@style/Shadowed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-light"
                            android:includeFontPadding="false"
                            android:textColor="?attr/tsText"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/weatherDetail"
                            style="@style/Shadowed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:maxLines="1"
                            android:textColor="?attr/tsTextSecondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- A clock with hands, when chosen -->
                <com.tunastream.home.ClockFace
                    android:id="@+id/clockFace"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/clockBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextClock
                        android:id="@+id/clock"
                        style="@style/Shadowed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:includeFontPadding="false"
                        android:textColor="?attr/tsText"
                        android:textSize="26sp" />

                    <TextClock
                        android:id="@+id/date"
                        style="@style/Shadowed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="?attr/tsTextSecondary"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/appsHint"
                style="@style/Shadowed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/safe_side"
                android:layout_marginTop="14dp"
                android:text="@string/loading_apps"
                android:textColor="?attr/tsTextSecondary"
                android:textSize="13sp" />

            <!-- One section per row the viewer has, added in code -->
            <LinearLayout
                android:id="@+id/sections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical" />
        </LinearLayout>
    </com.tunastream.home.HomeScroll>

    <!-- The side menu: Left from the first app opens it -->
    <FrameLayout
        android:id="@+id/sideMenu"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/sideMenuShade"
            android:layout_width="420dp"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@drawable/side_menu_shade" />

        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/sideMenuItems"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:descendantFocusability="blocksDescendants"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="96dp"
                android:paddingEnd="12dp"
                android:paddingBottom="@dimen/safe_top" />
        </ScrollView>
    </FrameLayout>
</FrameLayout>
