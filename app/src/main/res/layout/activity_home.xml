<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Your own picture, when one is chosen in Settings; otherwise the theme's colours show -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!-- Darkens a picture a little so names and the clock stay readable -->
    <View
        android:id="@+id/wallpaperShade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#59000000"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:fadingEdgeLength="56dp"
        android:fillViewport="true"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingTop="@dimen/safe_top"
            android:paddingBottom="@dimen/safe_top">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/safe_side"
                android:layout_marginEnd="@dimen/safe_side"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <include layout="@layout/brand" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/checkUpdate"
                    style="@style/IconButton"
                    android:contentDescription="@string/set_update"
                    android:src="@drawable/ic_update" />

                <ImageView
                    android:id="@+id/openTvSettings"
                    style="@style/IconButton"
                    android:contentDescription="@string/tv_settings"
                    android:src="@drawable/ic_tv" />

                <ImageView
                    android:id="@+id/openSettings"
                    style="@style/IconButton"
                    android:contentDescription="@string/tunahome_settings"
                    android:src="@drawable/ic_settings" />

                <TextClock
                    android:id="@+id/clock"
                    style="@style/Shadowed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-light"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="?attr/tsText"
                    android:textSize="26sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/appsHint"
                style="@style/Shadowed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/safe_side"
                android:layout_marginTop="14dp"
                android:text="@string/loading_apps"
                android:textColor="?attr/tsTextSecondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/favouritesTitle"
                style="@style/RowTitle"
                android:text="@string/favourites" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/favourites"
                style="@style/AppRow" />

            <TextView
                android:id="@+id/tvAppsTitle"
                style="@style/RowTitle"
                android:text="@string/tv_apps" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tvApps"
                style="@style/AppRow" />

            <TextView
                android:id="@+id/mobileAppsTitle"
                style="@style/RowTitle"
                android:text="@string/mobile_apps" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mobileApps"
                style="@style/AppRow" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
