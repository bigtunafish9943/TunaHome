<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The background: a picture, a video, or nothing (the theme's colours) -->
    <ImageView
        android:id="@+id/backdropImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <androidx.media3.ui.PlayerView
        android:id="@+id/backdropVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:descendantFocusability="blocksDescendants"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:resize_mode="zoom"
        app:shutter_background_color="@android:color/transparent"
        app:surface_type="texture_view"
        app:use_controller="false" />

    <!-- Darkens the background so names and the clock stay readable -->
    <View
        android:id="@+id/backdropShade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.3"
        android:background="#FF000000"
        android:visibility="gone" />

    <!-- What the background shows, when a wallpaper app names it -->
    <TextView
        android:id="@+id/backdropCaption"
        style="@style/Shadowed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/safe_side"
        android:layout_marginBottom="@dimen/safe_top"
        android:textColor="?attr/tsText"
        android:textSize="13sp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:fadingEdgeLength="56dp"
        android:fillViewport="true"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingTop="@dimen/safe_top"
            android:paddingBottom="@dimen/safe_top">

            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/safe_side"
                android:layout_marginEnd="@dimen/safe_side"
                android:gravity="center_vertical"
                android:minHeight="46dp"
                android:orientation="horizontal">

                <include layout="@layout/brand" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/networkIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="14dp"
                    android:alpha="0.85"
                    android:contentDescription="@null"
                    android:focusable="false"
                    android:tint="?attr/tsText"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/checkUpdate"
                    style="@style/IconButton"
                    android:contentDescription="@string/set_update"
                    android:src="@drawable/ic_update" />

                <ImageView
                    android:id="@+id/openTvSettings"
                    style="@style/IconButton"
                    android:contentDescription="@string/tv_settings"
                    android:src="@drawable/ic_tv" />

                <ImageView
                    android:id="@+id/openSettings"
                    style="@style/IconButton"
                    android:contentDescription="@string/tunahome_settings"
                    android:src="@drawable/ic_settings" />

                <LinearLayout
                    android:id="@+id/clockBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextClock
                        android:id="@+id/clock"
                        style="@style/Shadowed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:includeFontPadding="false"
                        android:textColor="?attr/tsText"
                        android:textSize="26sp" />

                    <TextClock
                        android:id="@+id/date"
                        style="@style/Shadowed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="?attr/tsTextSecondary"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/appsHint"
                style="@style/Shadowed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/safe_side"
                android:layout_marginTop="14dp"
                android:text="@string/loading_apps"
                android:textColor="?attr/tsTextSecondary"
                android:textSize="13sp" />

            <!-- One section per row the viewer has, added in code -->
            <LinearLayout
                android:id="@+id/sections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
