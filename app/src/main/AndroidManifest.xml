<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Checking for and downloading updates from GitHub -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reading Android TV's Watch Next list (an ordinary permission, granted at install) -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <!-- Watch Next from other apps: the TV only shares other apps' shows with this (asked once) -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <!-- The network icon beside the clock: Wi-Fi, wired or not connected -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Installing an update after you agree to it -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Offering "Uninstall" in an app's menu; Android still asks you to confirm -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- The apps a home screen lists: anything with a TV or ordinary launcher entry -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Wallpaper apps such as Aerial Views (Projectivy's wallpaper plugin interface) -->
        <intent>
            <action android:name="tv.projectivy.plugin.WALLPAPER_PROVIDER" />
        </intent>
        <!-- Icon packs -->
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="com.gau.go.launcherex.theme" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.anddoes.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.teslacoilsw.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.fede.launcher.THEME_ICONPACK" />
        </intent>
        <intent>
            <action android:name="org.adw.ActivityStarter.THEMES" />
        </intent>
        <intent>
            <action android:name="com.dlto.atom.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="ch.deletescape.lawnchair.ICONPACK" />
        </intent>
        <intent>
            <action android:name="app.lawnchair.icons.THEMED_ICON" />
        </intent>
        <intent>
            <action android:name="net.oneplus.launcher.icons.ACTION_PICK_ICON" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.category.CUSTOM_ICON_PICKER" />
        </intent>
        <!-- To picture a web link by the app that opens it -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <!-- TunaReceive shares the games on your PC -->
        <package android:name="com.tunastream.receive" />
        <!-- The icon packs TunaHome can download, so it can see them once installed -->
        <package android:name="com.donnnno.arcticons" />
        <package android:name="com.donnnno.arcticons.light" />
        <package android:name="com.donnnno.arcticons.daynight" />
        <package android:name="com.donnnno.arcticons.you" />
        <package android:name="website.leifs.delta.foss" />
        <package android:name="dev.appstract.iconpack" />
        <package android:name="org.baitmooth.snow" />
        <package android:name="me.x2gd4.dollphone" />
        <package android:name="de.moooon.acrylicons" />
        <package android:name="org.xphnx.ameixa" />
        <package android:name="org.xphnx.ameixamonochrome" />
        <package android:name="com.mookie.circo" />
        <package android:name="me.iacn.mbestyle" />
        <package android:name="com.kn.paper_foss_theme" />
        <package android:name="org.materialos.icons" />
        <package android:name="com.froxot.cuscon.foss" />
        <package android:name="app.lawnchair.lawnicons" />
        <package android:name="k4ustu3h.monocons.izzy" />
        <!-- Voice search, and searching everything with the TV's own search -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.ASSIST" />
        </intent>
        <!-- Offering Aerial Views in the Play Store when no wallpaper app is installed -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <!-- Find my remote: the SHIELD's remote locator -->
        <package android:name="com.nvidia.remotelocator" />
    </queries>

    <!-- Open apps: closing an app the viewer chose -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Remote and controller batteries on the top bar (Bluetooth devices' names and levels only) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:allowBackup="true"
        android:banner="@drawable/atv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/TunaHome"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".HomeActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A home screen as far as Android is concerned: listed by launcher managers
                 (TV Box Tools' Launcher Manager and others) and the TV's own Home app choice,
                 so it can be made the default -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SearchActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode"
            android:exported="false"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="stateVisible|adjustNothing" />

        <activity
            android:name=".SettingsActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".PhoneSetupActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".WhoActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode"
            android:exported="false"
            android:screenOrientation="landscape" />
        <!-- Time's up: in place of an app over its daily limit, or one kids mode doesn't allow -->
        <activity
            android:name=".TimesUpActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:taskAffinity="com.tunastream.home.timesup" />
        <!-- The morning screen: once each morning, over the home screen -->
        <activity
            android:name=".MorningActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="landscape" />
        <!-- Picture test: test patterns, from TunaHome settings -->
        <activity
            android:name=".PictureTestActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode"
            android:exported="false"
            android:screenOrientation="landscape" />
        <!-- Open apps (Home pressed twice): its own task, so Back returns to the app it opened over -->
        <activity
            android:name=".OpenAppsActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:taskAffinity="com.tunastream.home.openapps" />
        <activity
            android:name=".WelcomeActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- Opens TunaHome when Home is pressed. Off until you switch it on in the TV's
             accessibility settings; switching it off there undoes it. -->
        <service
            android:name=".HomeButtonService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_button_service" />
        </service>

        <!-- Now playing: lets Android tell TunaHome what's playing, once the viewer allows it -->
        <service
            android:name=".NowPlayingListener"
            android:exported="true"
            android:label="@string/np_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- TunaHome as the screen saver: picked by the viewer in the TV's own screen saver settings -->
        <service
            android:name=".Screensaver"
            android:exported="true"
            android:label="@string/screensaver_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".Updater$InstallResultReceiver"
            android:exported="false" />
        <receiver
            android:name=".IconPackStore$InstallResult"
            android:exported="false" />
    </application>
</manifest>
